<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_SispagProposto" targetNamespace="http://kavex.at/financeiro/bpmn/sispag" exporter="kavex bpmn-generate" exporterVersion="1.0">
  <bpmn2:documentation>SISPAG (Frente II) — fluxo PROPOSTO (to-be), visão de negócio. Novidades: alerta de duplicidade com bloqueio e aprovação por segunda pessoa; envio e retorno bancário automáticos via Nexxera.</bpmn2:documentation>
  <bpmn2:error id="Error_FalhaRemessa" name="Falha na remessa" errorCode="FALHA_REMESSA" />
  <bpmn2:message id="Message_Ret" name=".RET disponível" />
  <bpmn2:collaboration id="Collaboration_Sispag">
    <bpmn2:participant id="Participant_Banco" name="Banco (via Nexxera)" />
    <bpmn2:participant id="Participant_Columbia" name="Columbia Trading — Pagamentos (SISPAG)" processRef="Process_Sispag" />
    <bpmn2:participant id="Participant_Conexos" name="Conexos (ERP)" />
    <bpmn2:messageFlow id="MessageFlow_Titulos" name="títulos e dados de pagamento" sourceRef="Participant_Conexos" targetRef="Task_BuscarTitulos" />
    <bpmn2:messageFlow id="MessageFlow_Cancelamento" name="pedido de cancelamento" sourceRef="Task_RetirarTitulo" targetRef="Participant_Conexos" />
    <bpmn2:messageFlow id="MessageFlow_Remessa" name="gera a remessa" sourceRef="Task_GerarRemessa" targetRef="Participant_Conexos" />
    <bpmn2:messageFlow id="MessageFlow_EnviarRemessa" name="arquivo de remessa" sourceRef="Task_EnviarBanco" targetRef="Participant_Banco" />
    <bpmn2:messageFlow id="MessageFlow_Retorno" name="arquivo de retorno" sourceRef="Participant_Banco" targetRef="Event_RetornoBanco" />
    <bpmn2:messageFlow id="MessageFlow_Baixa" name="baixa dos títulos pagos" sourceRef="Task_ProcessarRetorno" targetRef="Participant_Conexos" />
  </bpmn2:collaboration>
  <bpmn2:process id="Process_Sispag" name="SISPAG — pagamento a fornecedores (proposto)" isExecutable="false">
    <bpmn2:laneSet id="LaneSet_Columbia">
      <bpmn2:lane id="Lane_Analista" name="Analista Financeiro">
        <bpmn2:flowNodeRef>Gateway_MergeRevisao</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RevisarLote</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_TemAlerta</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_AnalisarAlerta</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_EDuplicado</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_Justificar</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RetirarTitulo</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_MergeAprovacao</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_AprovarLote</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_TemTedPix</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_CorrigirPendencias</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_TratarRejeicao</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Aprovador" name="Aprovador (segunda pessoa)">
        <bpmn2:flowNodeRef>Task_ConferirTedPix</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_Conferido</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Sistema" name="Sistema Kavex">
        <bpmn2:flowNodeRef>StartEvent_Diario</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_BuscarTitulos</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_MontarLotes</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_VerificarTedPix</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_FaltamDados</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_AlertarResponsavel</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_MergeDados</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_MergeRemessa</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_GerarRemessa</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_ArquivoValido</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_EnviarBanco</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_MergeRetorno</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Event_RetornoBanco</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ProcessarRetorno</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_Resultado</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_LotePago</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>
    <bpmn2:startEvent id="StartEvent_Diario" name="Todo dia, 07h">
      <bpmn2:outgoing>Flow_01</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="TimerDef_StartEvent_Diario">
        <bpmn2:timeCycle xsi:type="bpmn2:tFormalExpression">0 10 * * *</bpmn2:timeCycle>
      </bpmn2:timerEventDefinition>
    </bpmn2:startEvent>
    <bpmn2:serviceTask id="Task_BuscarTitulos" name="Buscar títulos a pagar aprovados no Conexos">
      <bpmn2:incoming>Flow_01</bpmn2:incoming>
      <bpmn2:outgoing>Flow_02</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_MontarLotes" name="Montar lotes por filial (vencimento em até 7 dias)">
      <bpmn2:incoming>Flow_02</bpmn2:incoming>
      <bpmn2:outgoing>Flow_03</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_MergeRevisao">
      <bpmn2:incoming>Flow_03</bpmn2:incoming>
      <bpmn2:incoming>Flow_28</bpmn2:incoming>
      <bpmn2:incoming>Flow_37</bpmn2:incoming>
      <bpmn2:outgoing>Flow_04</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_RevisarLote" name="Revisar lote e definir a forma de pagamento de cada título">
      <bpmn2:incoming>Flow_04</bpmn2:incoming>
      <bpmn2:outgoing>Flow_05</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:serviceTask id="Task_VerificarTedPix" name="Verificar títulos TED e PIX do lote">
      <bpmn2:incoming>Flow_05</bpmn2:incoming>
      <bpmn2:outgoing>Flow_06</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_FaltamDados" name="Falta dado de pagamento?">
      <bpmn2:incoming>Flow_06</bpmn2:incoming>
      <bpmn2:outgoing>Flow_07</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_08</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sendTask id="Task_AlertarResponsavel" name="Alertar responsável pelo cadastro">
      <bpmn2:incoming>Flow_08</bpmn2:incoming>
      <bpmn2:outgoing>Flow_09</bpmn2:outgoing>
    </bpmn2:sendTask>
    <bpmn2:exclusiveGateway id="Gateway_MergeDados">
      <bpmn2:incoming>Flow_07</bpmn2:incoming>
      <bpmn2:incoming>Flow_09</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_TemAlerta" name="Há título com alerta de duplicidade?">
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
      <bpmn2:outgoing>Flow_11</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_12</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_AnalisarAlerta" name="Analisar o alerta">
      <bpmn2:incoming>Flow_12</bpmn2:incoming>
      <bpmn2:outgoing>Flow_13</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_EDuplicado" name="É duplicado?">
      <bpmn2:incoming>Flow_13</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_15</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_Justificar" name="Justificar o pagamento do título">
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
      <bpmn2:outgoing>Flow_16</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Task_RetirarTitulo" name="Retirar título do lote e pedir cancelamento no Conexos">
      <bpmn2:incoming>Flow_15</bpmn2:incoming>
      <bpmn2:outgoing>Flow_17</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_MergeAprovacao">
      <bpmn2:incoming>Flow_11</bpmn2:incoming>
      <bpmn2:incoming>Flow_16</bpmn2:incoming>
      <bpmn2:incoming>Flow_17</bpmn2:incoming>
      <bpmn2:outgoing>Flow_18</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_AprovarLote" name="Aprovar lote">
      <bpmn2:incoming>Flow_18</bpmn2:incoming>
      <bpmn2:outgoing>Flow_19</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_TemTedPix" name="Lote tem TED ou PIX?">
      <bpmn2:incoming>Flow_19</bpmn2:incoming>
      <bpmn2:outgoing>Flow_20</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_21</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_ConferirTedPix" name="Conferir pagamentos TED e PIX">
      <bpmn2:incoming>Flow_20</bpmn2:incoming>
      <bpmn2:outgoing>Flow_22</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_Conferido" name="Conferido?">
      <bpmn2:incoming>Flow_22</bpmn2:incoming>
      <bpmn2:outgoing>Flow_23</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_24</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Task_CorrigirPendencias" name="Corrigir pendências do lote">
      <bpmn2:incoming>Flow_24</bpmn2:incoming>
      <bpmn2:incoming>Flow_27</bpmn2:incoming>
      <bpmn2:outgoing>Flow_28</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_MergeRemessa">
      <bpmn2:incoming>Flow_21</bpmn2:incoming>
      <bpmn2:incoming>Flow_23</bpmn2:incoming>
      <bpmn2:outgoing>Flow_25</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:serviceTask id="Task_GerarRemessa" name="Gerar arquivo de remessa no Conexos">
      <bpmn2:incoming>Flow_25</bpmn2:incoming>
      <bpmn2:outgoing>Flow_26</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_ArquivoValido" name="Arquivo válido?">
      <bpmn2:incoming>Flow_26</bpmn2:incoming>
      <bpmn2:outgoing>Flow_27</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_29</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:serviceTask id="Task_EnviarBanco" name="Enviar remessa ao banco">
      <bpmn2:incoming>Flow_29</bpmn2:incoming>
      <bpmn2:outgoing>Flow_30</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_MergeRetorno">
      <bpmn2:incoming>Flow_30</bpmn2:incoming>
      <bpmn2:incoming>Flow_36</bpmn2:incoming>
      <bpmn2:outgoing>Flow_31</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:intermediateCatchEvent id="Event_RetornoBanco" name="Retorno do banco recebido">
      <bpmn2:incoming>Flow_31</bpmn2:incoming>
      <bpmn2:outgoing>Flow_32</bpmn2:outgoing>
      <bpmn2:messageEventDefinition id="MessageDef_Event_RetornoBanco" messageRef="Message_Ret" />
    </bpmn2:intermediateCatchEvent>
    <bpmn2:serviceTask id="Task_ProcessarRetorno" name="Processar retorno e dar baixa no Conexos">
      <bpmn2:incoming>Flow_32</bpmn2:incoming>
      <bpmn2:outgoing>Flow_33</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_Resultado" name="Resultado do pagamento?">
      <bpmn2:incoming>Flow_33</bpmn2:incoming>
      <bpmn2:outgoing>Flow_34</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_35</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_36</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="EndEvent_LotePago" name="Lote pago">
      <bpmn2:incoming>Flow_34</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:userTask id="Task_TratarRejeicao" name="Tratar rejeição (corrigir cadastro e repagar)">
      <bpmn2:incoming>Flow_35</bpmn2:incoming>
      <bpmn2:outgoing>Flow_37</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_01" sourceRef="StartEvent_Diario" targetRef="Task_BuscarTitulos" />
    <bpmn2:sequenceFlow id="Flow_02" sourceRef="Task_BuscarTitulos" targetRef="Task_MontarLotes" />
    <bpmn2:sequenceFlow id="Flow_03" sourceRef="Task_MontarLotes" targetRef="Gateway_MergeRevisao" />
    <bpmn2:sequenceFlow id="Flow_04" sourceRef="Gateway_MergeRevisao" targetRef="Task_RevisarLote" />
    <bpmn2:sequenceFlow id="Flow_05" sourceRef="Task_RevisarLote" targetRef="Task_VerificarTedPix" />
    <bpmn2:sequenceFlow id="Flow_06" sourceRef="Task_VerificarTedPix" targetRef="Gateway_FaltamDados" />
    <bpmn2:sequenceFlow id="Flow_07" name="Não" sourceRef="Gateway_FaltamDados" targetRef="Gateway_MergeDados" />
    <bpmn2:sequenceFlow id="Flow_08" name="Sim" sourceRef="Gateway_FaltamDados" targetRef="Task_AlertarResponsavel" />
    <bpmn2:sequenceFlow id="Flow_09" name="título sai do lote" sourceRef="Task_AlertarResponsavel" targetRef="Gateway_MergeDados" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Gateway_MergeDados" targetRef="Gateway_TemAlerta" />
    <bpmn2:sequenceFlow id="Flow_11" name="Não" sourceRef="Gateway_TemAlerta" targetRef="Gateway_MergeAprovacao" />
    <bpmn2:sequenceFlow id="Flow_12" name="Sim" sourceRef="Gateway_TemAlerta" targetRef="Task_AnalisarAlerta" />
    <bpmn2:sequenceFlow id="Flow_13" sourceRef="Task_AnalisarAlerta" targetRef="Gateway_EDuplicado" />
    <bpmn2:sequenceFlow id="Flow_14" name="Não, quero pagar" sourceRef="Gateway_EDuplicado" targetRef="Task_Justificar" />
    <bpmn2:sequenceFlow id="Flow_15" name="Sim" sourceRef="Gateway_EDuplicado" targetRef="Task_RetirarTitulo" />
    <bpmn2:sequenceFlow id="Flow_16" sourceRef="Task_Justificar" targetRef="Gateway_MergeAprovacao" />
    <bpmn2:sequenceFlow id="Flow_17" sourceRef="Task_RetirarTitulo" targetRef="Gateway_MergeAprovacao" />
    <bpmn2:sequenceFlow id="Flow_18" sourceRef="Gateway_MergeAprovacao" targetRef="Task_AprovarLote" />
    <bpmn2:sequenceFlow id="Flow_19" sourceRef="Task_AprovarLote" targetRef="Gateway_TemTedPix" />
    <bpmn2:sequenceFlow id="Flow_20" name="Sim" sourceRef="Gateway_TemTedPix" targetRef="Task_ConferirTedPix" />
    <bpmn2:sequenceFlow id="Flow_21" name="Não (só boleto)" sourceRef="Gateway_TemTedPix" targetRef="Gateway_MergeRemessa" />
    <bpmn2:sequenceFlow id="Flow_22" sourceRef="Task_ConferirTedPix" targetRef="Gateway_Conferido" />
    <bpmn2:sequenceFlow id="Flow_23" name="Sim" sourceRef="Gateway_Conferido" targetRef="Gateway_MergeRemessa" />
    <bpmn2:sequenceFlow id="Flow_24" name="Não" sourceRef="Gateway_Conferido" targetRef="Task_CorrigirPendencias" />
    <bpmn2:sequenceFlow id="Flow_25" sourceRef="Gateway_MergeRemessa" targetRef="Task_GerarRemessa" />
    <bpmn2:sequenceFlow id="Flow_26" sourceRef="Task_GerarRemessa" targetRef="Gateway_ArquivoValido" />
    <bpmn2:sequenceFlow id="Flow_27" name="Não" sourceRef="Gateway_ArquivoValido" targetRef="Task_CorrigirPendencias" />
    <bpmn2:sequenceFlow id="Flow_28" sourceRef="Task_CorrigirPendencias" targetRef="Gateway_MergeRevisao" />
    <bpmn2:sequenceFlow id="Flow_29" name="Sim" sourceRef="Gateway_ArquivoValido" targetRef="Task_EnviarBanco" />
    <bpmn2:sequenceFlow id="Flow_30" sourceRef="Task_EnviarBanco" targetRef="Gateway_MergeRetorno" />
    <bpmn2:sequenceFlow id="Flow_31" sourceRef="Gateway_MergeRetorno" targetRef="Event_RetornoBanco" />
    <bpmn2:sequenceFlow id="Flow_32" sourceRef="Event_RetornoBanco" targetRef="Task_ProcessarRetorno" />
    <bpmn2:sequenceFlow id="Flow_33" sourceRef="Task_ProcessarRetorno" targetRef="Gateway_Resultado" />
    <bpmn2:sequenceFlow id="Flow_34" name="Todos pagos" sourceRef="Gateway_Resultado" targetRef="EndEvent_LotePago" />
    <bpmn2:sequenceFlow id="Flow_35" name="Rejeitado" sourceRef="Gateway_Resultado" targetRef="Task_TratarRejeicao" />
    <bpmn2:sequenceFlow id="Flow_36" name="Aguardando confirmação" sourceRef="Gateway_Resultado" targetRef="Gateway_MergeRetorno" />
    <bpmn2:sequenceFlow id="Flow_37" sourceRef="Task_TratarRejeicao" targetRef="Gateway_MergeRevisao" />
    <bpmn2:textAnnotation id="Annotation_Conexos">
      <bpmn2:text>Dados do pagamento (código de barras, conta bancária, chave PIX) continuam vindo do cadastro do Conexos — ninguém digita conta.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_Conexos" sourceRef="Annotation_Conexos" targetRef="Task_BuscarTitulos" />
    <bpmn2:textAnnotation id="Annotation_Verificacoes">
      <bpmn2:text>NOVO. Roda depois que a analista define a forma de pagamento, só para TED e PIX (boleto fica de fora: o banco trata, e o código de barras só é confirmado na remessa). 1) Duplicidade — forte: mesmo fornecedor + mesmo nº de NF, inclusive já pagos; fraca: mesmo fornecedor + valor + vencimento próximo. 2) Canal habitual — fornecedor que sempre recebeu boleto e agora vai TED/PIX gera alerta para a conferência. 3) Dados de pagamento — conta ou chave PIX faltando.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_Verificacoes" sourceRef="Annotation_Verificacoes" targetRef="Task_VerificarTedPix" />
    <bpmn2:textAnnotation id="Annotation_DadosFaltantes">
      <bpmn2:text>NOVO. O alerta vai para quem tem a permissão de responsável pelo cadastro (acesso ao cadastro do Conexos); o título sai do lote até ser corrigido.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_DadosFaltantes" sourceRef="Annotation_DadosFaltantes" targetRef="Task_AlertarResponsavel" />
    <bpmn2:textAnnotation id="Annotation_Bloqueio">
      <bpmn2:text>NOVO. Lote com alerta não pode ser aprovado até o alerta ser resolvido.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_Bloqueio" sourceRef="Annotation_Bloqueio" targetRef="Task_AnalisarAlerta" />
    <bpmn2:textAnnotation id="Annotation_Boleto">
      <bpmn2:text>Boleto não passa pela segunda conferência: o banco trata esses casos.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_Boleto" sourceRef="Annotation_Boleto" targetRef="Gateway_TemTedPix" />
    <bpmn2:textAnnotation id="Annotation_QuatroOlhos">
      <bpmn2:text>NOVO. Todo TED e PIX passa por uma segunda pessoa: confere favorecido, conta ou chave PIX, valor, alertas de duplicidade (com a justificativa) e alertas de canal fora do habitual. Quem montou o lote não confere.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_QuatroOlhos" sourceRef="Annotation_QuatroOlhos" targetRef="Task_ConferirTedPix" />
    <bpmn2:textAnnotation id="Annotation_Automatico">
      <bpmn2:text>NOVO. Envio da remessa e leitura do retorno automáticos via Nexxera (hoje é manual).</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_Annotation_Automatico" sourceRef="Annotation_Automatico" targetRef="Task_EnviarBanco" />
    <bpmn2:textAnnotation id="Annotation_Legenda">
      <bpmn2:text>Legenda — azul: sistema · verde: analista · laranja: novo nesta proposta · vermelho: tratamento de exceção · cinza: sistemas externos</bpmn2:text>
    </bpmn2:textAnnotation>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="Diagram_Sispag">
    <bpmndi:BPMNPlane id="Plane_Sispag" bpmnElement="Collaboration_Sispag">
      <bpmndi:BPMNShape id="Participant_Banco_di" bpmnElement="Participant_Banco" isHorizontal="true" isExpanded="false" bioc:fill="#F5F5F5" bioc:stroke="#616161" color:background-color="#F5F5F5" color:border-color="#616161">
        <dc:Bounds x="0" y="0" width="5800" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Columbia_di" bpmnElement="Participant_Columbia" isHorizontal="true" isExpanded="true">
