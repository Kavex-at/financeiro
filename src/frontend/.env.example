# Backend API base URL (where the username/password login lives).
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Autenticação: Supabase Auth (GoTrue) — ADR-0030 ─────────────────────────
# A sessão é custodiada pelo Supabase em COOKIES (@supabase/ssr), com refresh
# automático, rotação e revogação real no `signOut`. O token NÃO vive mais em
# localStorage. O `role` do JWT é sempre 'authenticated' e é ignorado: o papel
# vem do banco, por `GET /me`.
#
# ⚠️ A SUPABASE_SERVICE_ROLE_KEY NUNCA entra aqui. Ela ignora RLS e pode criar
# usuários — vive só no backend (Render). Há um teste-guarda que varre este
# pacote inteiro atrás dela.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — publicável por desenho>

# Provedor de identidade em uso. `supabase` na Fase 2 do rollout; `legacy`
# é o rollback, e vale SEM redeploy do backend.
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# NEXT_PUBLIC_DEV_AUTH_BYPASS=true skips the auth gate so local development
# works without logging in. Default off — must NEVER be true in a deployed
# build.
# NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# NEXT_PUBLIC_ENV identifies the running environment. Dev-bypass is only
# permitted when this is "local" (the default for local dev). On any other
# value (prd/stg/hml/…) a build with NEXT_PUBLIC_DEV_AUTH_BYPASS=true crashes
# at startup via assertAuthEnv() instead of shipping unauthenticated
# (arch-review card security-1).
NEXT_PUBLIC_ENV=local
