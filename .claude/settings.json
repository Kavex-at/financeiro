{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx biome:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(aws ssm get-parameter:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws lambda list-functions:*)",
      "Bash(aws lambda invoke:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(terraform output:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(aws ssm put-parameter:*)",
      "Bash(aws ssm delete-parameter:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws lambda delete-function:*)",
      "Bash(aws iam:*)",
      "Bash(aws organizations:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook-board-cards-bash.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
